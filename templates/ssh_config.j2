# SSH Client Configuration - Hardened
# Generated by Ansible SSH Hardening Role
# {{ ansible_managed }}

# Global SSH client settings
Host *
    # Protocol and Security
    
    # Key Exchange Algorithms (only secure ones)
    KexAlgorithms {{ ssh_client_kex_algorithms | default(ssh_kex_algorithms) | join(',') }}
    
    # Ciphers (only secure ones)
    Ciphers {{ ssh_client_ciphers | default(ssh_ciphers) | join(',') }}
    
    # MAC Algorithms (only secure ones)
    MACs {{ ssh_client_macs | default(ssh_macs) | join(',') }}
    
    # Host Key Algorithms
    HostKeyAlgorithms {{ ssh_client_host_key_algorithms | join(',') }}
    PubkeyAcceptedKeyTypes {{ ssh_client_pubkey_accepted_key_types | join(',') }}
    
    # Authentication
    PasswordAuthentication {{ ssh_client_password_authentication | default('no') }}
    ChallengeResponseAuthentication {{ ssh_client_challenge_response_auth | default('no') }}
    PubkeyAuthentication {{ ssh_client_pubkey_authentication | default('yes') }}
    
    # Security Settings
    StrictHostKeyChecking {{ ssh_client_strict_host_key_checking | default('ask') }}
    VerifyHostKeyDNS {{ ssh_client_verify_host_key_dns | default('yes') }}
    ForwardAgent {{ ssh_client_forward_agent | default('no') }}
    ForwardX11 {{ ssh_client_forward_x11 | default('no') }}
    ForwardX11Trusted {{ ssh_client_forward_x11_trusted | default('no') }}
    
    # Connection Settings
    ServerAliveInterval {{ ssh_client_server_alive_interval | default('300') }}
    ServerAliveCountMax {{ ssh_client_server_alive_count_max | default('2') }}
    TCPKeepAlive {{ ssh_client_tcp_keep_alive | default('yes') }}
    
    # Compression
    Compression {{ ssh_client_compression | default('no') }}
    
    # Logging
    LogLevel {{ ssh_client_log_level | default('INFO') }}
    
    # Hash known hosts for privacy
    HashKnownHosts {{ ssh_client_hash_known_hosts | default('yes') }}
    
    # Disable unused features
    GSSAPIAuthentication no
    GSSAPIDelegateCredentials no
    HostbasedAuthentication no