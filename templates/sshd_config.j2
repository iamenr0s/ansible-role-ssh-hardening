# SSH Daemon Configuration - Hardened
# Generated by Ansible SSH Hardening Role
# {{ ansible_managed }}

# Network Configuration
Port {{ ssh_port }}
{% if ssh_listen_addresses %}
{% for address in ssh_listen_addresses %}
ListenAddress {{ address }}
{% endfor %}
{% endif %}
AddressFamily {{ ssh_address_family }}

# Protocol and Encryption

# Host Keys - Only use strong algorithms
{% for key_type in ssh_host_key_types %}
HostKey /etc/ssh/ssh_host_{{ key_type }}_key
{% endfor %}

# Key Exchange Algorithms (only secure ones)
KexAlgorithms {{ ssh_kex_algorithms | join(',') }}

# Ciphers (only secure ones)
Ciphers {{ ssh_ciphers | join(',') }}

# MAC Algorithms (only secure ones)
MACs {{ ssh_macs | join(',') }}

# Authentication Settings
LoginGraceTime {{ ssh_login_grace_time }}
PermitRootLogin {{ ssh_permit_root_login }}
StrictModes {{ ssh_strict_modes }}
MaxAuthTries {{ ssh_max_auth_tries }}
MaxSessions {{ ssh_max_sessions }}
MaxStartups {{ ssh_max_startups }}

# Public Key Authentication
PubkeyAuthentication {{ ssh_pubkey_authentication }}
AuthorizedKeysFile {{ ssh_authorized_keys_file }}

# Password Authentication
PasswordAuthentication {{ ssh_password_authentication }}
PermitEmptyPasswords {{ ssh_permit_empty_passwords }}
ChallengeResponseAuthentication {{ ssh_challenge_response_auth }}

# Kerberos Authentication
KerberosAuthentication {{ ssh_kerberos_authentication }}
KerberosOrLocalPasswd {{ ssh_kerberos_or_local_passwd }}
KerberosTicketCleanup {{ ssh_kerberos_ticket_cleanup }}

# GSSAPI Authentication
GSSAPIAuthentication {{ ssh_gssapi_authentication }}
GSSAPICleanupCredentials {{ ssh_gssapi_cleanup_credentials }}

# User and Group Restrictions
{% if ssh_allow_users %}
AllowUsers {{ ssh_allow_users | join(' ') }}
{% endif %}
{% if ssh_deny_users %}
DenyUsers {{ ssh_deny_users | join(' ') }}
{% endif %}
{% if ssh_allow_groups %}
AllowGroups {{ ssh_allow_groups | join(' ') }}
{% endif %}
{% if ssh_deny_groups %}
DenyGroups {{ ssh_deny_groups | join(' ') }}
{% endif %}

# Forwarding and Tunneling
AllowAgentForwarding {{ ssh_allow_agent_forwarding }}
AllowTcpForwarding {{ ssh_allow_tcp_forwarding }}
GatewayPorts {{ ssh_gateway_ports }}
X11Forwarding {{ ssh_x11_forwarding }}
X11DisplayOffset {{ ssh_x11_display_offset }}
X11UseLocalhost {{ ssh_x11_use_localhost }}
PermitTTY {{ ssh_permit_tty }}
PermitTunnel {{ ssh_permit_tunnel }}

# Environment and Commands
PermitUserEnvironment {{ ssh_permit_user_environment }}
AcceptEnv {{ ssh_accept_env | join(' ') }}

# Compression
Compression {{ ssh_compression }}

# Client Alive Settings
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}

# Logging
SyslogFacility {{ ssh_syslog_facility }}
LogLevel {{ ssh_log_level }}

# Banner
{% if ssh_banner_enabled %}
Banner {{ ssh_banner_file }}
{% else %}
Banner none
{% endif %}

# Subsystems
{% for subsystem in ssh_subsystems %}
Subsystem {{ subsystem.name }} {{ subsystem.command }}
{% endfor %}

# Additional Security Settings
UseDNS {{ ssh_use_dns }}
PermitUserRC {{ ssh_permit_user_rc }}
PrintMotd {{ ssh_print_motd }}
PrintLastLog {{ ssh_print_last_log }}
TCPKeepAlive {{ ssh_tcp_keep_alive }}

# Disable unused authentication methods
HostbasedAuthentication no
IgnoreUserKnownHosts yes
IgnoreRhosts yes

# Additional hardening
AllowStreamLocalForwarding no
AuthenticationMethods {{ ssh_authentication_methods | join(' ') }}
{% if ssh_trusted_user_ca_keys %}
TrustedUserCAKeys {{ ssh_trusted_user_ca_keys }}
{% endif %}

# Match blocks for specific configurations
{% if ssh_match_blocks %}
{% for match in ssh_match_blocks %}
Match {{ match.condition }}
{% for key, value in match.settings.items() %}
    {{ key }} {{ value }}
{% endfor %}

{% endfor %}
{% endif %}